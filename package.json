{
  "name": "honowarden-web",
  "version": "0.0.0",
  "description": "Original browser vault for HonoWarden.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "vite build && node scripts/normalize-build.mjs --root dist",
    "build:e2e": "vite build --mode e2e && node scripts/normalize-build.mjs --root dist-e2e",
    "build:verify": "node scripts/verify-build.mjs",
    "check": "tsc --noEmit",
    "dev": "vite dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "release:manifest": "node scripts/release-manifest.mjs --output .workflow/hon-177-web-vault-foundation/results/release-manifest.json",
    "supply-chain:verify": "node scripts/verify-lockfile.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typegen": "wrangler types",
    "verify": "pnpm test && pnpm check && pnpm lint && pnpm format && pnpm supply-chain:verify && pnpm build && pnpm build:verify && pnpm release:manifest"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.45.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "10.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0",
    "yaml": "2.9.0"
  }
}
